# Same Firebase project as the root app — copy the values straight out of
# root/.env.local. Client-safe, not secrets (see root README).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# admin/api/*.js — the Admin SDK bootstrap. Same value as the root project's
# FIREBASE_SERVICE_ACCOUNT (Vercel env var, not this file — this is local dev
# only). Never commit the real value.
FIREBASE_SERVICE_ACCOUNT=

# Vercel Blob — material file uploads (admin/api/materials.js). Set by
# `vercel env pull` once the Blob store is provisioned via the Vercel
# Marketplace; see admin/api/materials.js for how it's used.
BLOB_READ_WRITE_TOKEN=
