# eslint-plugin-react-hooks@4.6.2 declares a peer range that predates eslint@9,
# so a strict install fails. Local installs have always needed
# --legacy-peer-deps for this; CI (Vercel) needs it too, and can't be passed a
# flag — hence this file. Remove once react-hooks ships eslint@9 support.
legacy-peer-deps=true
