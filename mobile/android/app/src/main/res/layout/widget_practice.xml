<?xml version="1.0" encoding="utf-8"?>
<!--
  Coding practice. See PracticeWidgetProvider.

  No colours here beyond a placeholder the provider immediately overwrites:
  every one is applied from the student's palette at draw time, because a
  colour written into a TextView cannot follow a palette change. See the note
  at the top of WidgetStyle.kt.

  Every text view is 0dp + weight or wrap_content inside its row, never
  match_parent — inside a horizontal LinearLayout that takes the parent's whole
  width and runs the text off the edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:padding="14dp"
    android:background="@drawable/widget_bg_accent">

    <TextView
        android:id="@+id/practice_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.07"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/practice_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <!-- The streak, beside the total. Right-aligned so the two read as one
             line rather than as a number with something stuck to it. -->
        <TextView
            android:id="@+id/practice_streak"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="3dp"
            android:gravity="end"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/practice_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Which platforms the total is made of, e.g. "LeetCode 253 · Codeforces
         190". Two lines at narrow widths, because five platform names do not
         fit on one. -->
    <TextView
        android:id="@+id/practice_platforms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="10sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
