<?xml version="1.0" encoding="utf-8"?>
<!--
  Preview only. Hardcoded content on purpose: the picker renders this with no
  provider running, so anything read from preferences comes out blank.

  Shown in the default (accent) palette, since the picker has no way to know
  which one the student chose either.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_accent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRACTICE"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.07"
        android:textColor="#FFE7D5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="248"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="3dp"
            android:gravity="end"
            android:text="6-day streak"
            android:textSize="11sp"
            android:textColor="#FFE7D5" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="3 of 5 this week"
        android:textSize="11sp"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="LeetCode 168 · Codeforces 80"
        android:textSize="10sp"
        android:textColor="#FFE7D5" />
</LinearLayout>
