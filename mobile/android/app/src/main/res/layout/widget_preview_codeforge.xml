<?xml version="1.0" encoding="utf-8"?>
<!--
  Preview only. Hardcoded content on purpose: the picker renders this with no
  provider running, so anything read from preferences comes out blank.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_forge">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CODEFORGE"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.07"
        android:textColor="#9CC3F0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:layout_marginTop="2dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="82%"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="3dp"
            android:gravity="end"
            android:text="41 / 50 sessions"
            android:textSize="11sp"
            android:textColor="#9CC3F0" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="82"
        android:progressDrawable="@drawable/widget_forge_bar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Arithmetic and Logical Ability"
        android:textSize="11sp"
        android:maxLines="2"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Next session Thu"
        android:textSize="10sp"
        android:textColor="#F9A857" />
</LinearLayout>
