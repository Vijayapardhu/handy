<?xml version="1.0" encoding="utf-8"?>
<!--
  CodeForge sessions. See CodeForgeWidgetProvider.

  Every text view here is 0dp + weight or wrap_content inside its row, never
  match_parent — inside a horizontal LinearLayout that means the parent's whole
  width and runs the text off the edge, which is exactly how the Today widget's
  class names ended up clipped instead of wrapped.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:padding="14dp"
    android:background="@drawable/widget_bg_forge">

    <TextView
        android:id="@+id/forge_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.07"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#9CC3F0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/forge_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/forge_sessions"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="3dp"
            android:gravity="end"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#9CC3F0" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/forge_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_forge_bar" />

    <!-- The worst course, which is the one worth a glance. Two lines, because a
         course is called "Arithmetic and Logical Ability" and that does not fit
         on one at this width. -->
    <TextView
        android:id="@+id/forge_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/forge_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#F9A857" />
</LinearLayout>
