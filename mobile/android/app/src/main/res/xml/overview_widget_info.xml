<?xml version="1.0" encoding="utf-8"?>
<!--
  Starts at two blocks tall because that is the point of it — one block is
  what the single-purpose widgets already do better. Drags up to four.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:initialLayout="@layout/widget_overview"
    android:previewLayout="@layout/widget_preview_overview"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_overview_description"
    android:updatePeriodMillis="1800000" />
