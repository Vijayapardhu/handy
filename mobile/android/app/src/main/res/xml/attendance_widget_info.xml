<?xml version="1.0" encoding="utf-8"?>
<!--
  One cell. The percentage is the entire content, so it needs exactly the room
  a number needs; the provider scales the type to whatever size it ends up.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="57dp"
    android:minHeight="57dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:initialLayout="@layout/widget_attendance"
    android:previewLayout="@layout/widget_preview_attendance"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_attendance_description"
    android:updatePeriodMillis="1800000" />
