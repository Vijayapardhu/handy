<?xml version="1.0" encoding="utf-8"?>
<!--
  Two cells wide, one tall: a percentage and a course name is the whole of it,
  and that fits on two rows. Resizes down to a single cell, where the provider
  drops everything but the number.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="130dp"
    android:minHeight="57dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:initialLayout="@layout/widget_codeforge"
    android:previewLayout="@layout/widget_preview_codeforge"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_codeforge_description"
    android:updatePeriodMillis="1800000" />
