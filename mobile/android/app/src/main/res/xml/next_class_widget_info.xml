<?xml version="1.0" encoding="utf-8"?>
<!--
  Two cells wide, one tall: a countdown and a subject is the whole question,
  and that fits on one row. Dragging it taller adds the time, then the room,
  then the faculty — see HandyWidgetProvider.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="130dp"
    android:minHeight="57dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:initialLayout="@layout/widget_next_class"
    android:previewLayout="@layout/widget_preview_next_class"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_next_class_description"
    android:updatePeriodMillis="1800000" />
