# Firebase Web SDK config (client-safe — NOT a secret, see SRS §57)
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Domain used to build synthetic emails for roll-number login (student "23A31A05B1" -> 23a31a05b1@handy.local)
VITE_AUTH_EMAIL_DOMAIN=handy.local

# Web Push (Firebase Console -> Cloud Messaging -> Web Push certificates).
# Public half of the VAPID key pair — safe in the client bundle.
VITE_FIREBASE_VAPID_KEY=

# ── Server-side portal sign-in (AEC / ACET) ────────────────────────────────
# Used by api/verify.js. Not client-safe: these belong in Vercel's environment,
# never in a VITE_ variable, or they ship in the browser bundle.

# The AES key Campus Connect's own login JavaScript uses to encrypt the password
# before posting it. Public — it is in a script tag on the login page — so this
# is not protecting anything; it only has to MATCH. It lives in env because the
# college has rotated it once already (8080808080808080 -> 8701661282118308),
# and when that happens every login fails at once looking like "wrong password".
# Only the first 16 characters of each are used.
AES_KEY=8701661282118308
AES_IV=8701661282118308

# Optional. Shouted at when a scrape breaks, so a portal change is noticed the
# same day rather than via a student complaint. Carries the campus, the error
# and the roll number — never a password.
DISCORD_WEBHOOK_URL=
