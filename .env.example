# Firebase Web SDK config (client-safe — NOT a secret, see SRS §57)
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Domain used to build synthetic emails for roll-number login (student "23A31A05B1" -> 23a31a05b1@handy.local)
VITE_AUTH_EMAIL_DOMAIN=handy.local

# Web Push (Firebase Console -> Cloud Messaging -> Web Push certificates).
# Public half of the VAPID key pair — safe in the client bundle.
VITE_FIREBASE_VAPID_KEY=

# ── Server-side portal sign-in (AEC / ACET) ────────────────────────────────
# Used by api/verify.js. Not client-safe: these belong in Vercel's environment,
# never in a VITE_ variable, or they ship in the browser bundle.

# The AES key Campus Connect's own login JavaScript uses to encrypt the password
# before posting it. Public — it is in a script tag on the login page — so this
# is not protecting anything; it only has to MATCH. It lives in env because the
# college has rotated it once already (8080808080808080 -> 8701661282118308),
# and when that happens every login fails at once looking like "wrong password".
# Only the first 16 characters of each are used.
AES_KEY=8701661282118308
AES_IV=8701661282118308

# Optional. Shouted at when a scrape breaks, so a portal change is noticed the
# same day rather than via a student complaint. Carries the campus, the error
# and the roll number — never a password.
DISCORD_WEBHOOK_URL=

# ── Hub (Maya/CodeForge) attendance ────────────────────────────────────────
# Used by api/hub-connect.js and api/hub-attendance.js. A student's Hub
# password is stored encrypted (at their request, so Handy can silently
# refresh their hour-long Maya token instead of asking them to sign in every
# session) — this is the server-only key that encrypts and decrypts it.
# Not client-safe, and unrelated to AES_KEY/AES_IV above (those encrypt a
# password to send it; this encrypts one to store it).
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Exactly 64 hex characters (32 bytes). Rotating it makes every already-stored
# Hub password undecryptable — those students would need to reconnect.
HUB_CRED_KEY=

# ── Complexity analysis (OpenRouter) ───────────────────────────────────────
# Used by api/coding-complexity.js to read the time and space complexity of a
# solution a student pasted. No coding platform publishes complexity, so it is
# derived from the code itself.
#
# In production the key lives in FIRESTORE, not here — `appConfig/ai`, a
# document with no rule block in firestore.rules and therefore unreadable by
# any browser. Set and rotate it with:
#
#   node scripts/set-ai-key.mjs sk-or-v1-...  [model]
#   node scripts/set-ai-key.mjs --status
#   node scripts/set-ai-key.mjs --disable
#
# These two variables are the local `vercel dev` fallback, checked only when
# that document has no key. Never give either a VITE_ prefix: that ships the
# key inside the browser bundle.
#
# With no key configured anywhere the feature switches itself off cleanly —
# students are told to type the complexity in themselves, and nothing else on
# the practice page is affected.
OPENROUTER_API_KEY=
# A free OpenRouter model — this project runs analysis at no per-request cost.
# Check https://openrouter.ai/models?max_price=0 before assuming this slug
# still exists; the free lineup turns over.
OPENROUTER_MODEL=cohere/north-mini-code:free
