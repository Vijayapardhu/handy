# Firebase Web SDK config (client-safe — NOT a secret, see SRS §57)
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Domain used to build synthetic emails for roll-number login (student "23A31A05B1" -> 23a31a05b1@handy.local)
VITE_AUTH_EMAIL_DOMAIN=handy.local

# Web Push (Firebase Console -> Cloud Messaging -> Web Push certificates).
# Public half of the VAPID key pair — safe in the client bundle.
VITE_FIREBASE_VAPID_KEY=
