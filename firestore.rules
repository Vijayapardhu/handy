rules_version = '2';

// SRS §36-37: Firestore Security Rules are the actual authorization boundary —
// the React app's route guards and the browser extension's UI are UX only.
// Nothing here trusts a client-supplied role/claim.
//
// Two kinds of client write to this database, and both are constrained to the
// caller's own uid:
//
//   1. The Handy web app (src/services/students/collegePortalImportService.ts).
//   2. The "Handy College Sync" browser extension (extension/), which signs in
//      as the student's own Firebase account over the Identity Toolkit REST
//      API and writes with that ID token — it holds no privileged credential
//      and is subject to exactly the same rules as the web app.
//
// Everything genuinely privileged (per-day attendance records, timetable
// publishing, leave approval, admin subject/faculty management) is still
// `allow write: if false` for every authenticated client and is performed by
// the Admin SDK (scripts/seed-students.mjs, or a future Cloud Function) which
// bypasses these rules entirely — that code never ships to the browser
// (SRS §57-58).

function isSignedIn() {
  return request.auth != null;
}

function isOwner(studentId) {
  return isSignedIn() && request.auth.uid == studentId;
}

// Private per-student namespace for self-registered (portal-import) data.
// `subjects` is a flat, read-open collection shared with admin-provisioned
// data, so every self-written subject is fenced into `self-<uid>` and can
// never collide with — or overwrite — another student's or an admin's rows.
// Mirrors selfImportSemesterId() in collegePortalImportService.ts.
function selfNamespace() {
  return 'self-' + request.auth.uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // The one door into every collection below, for the admin panel (admin/) —
    // a genuinely separate app and deployment from the one this file otherwise
    // describes. Checked first in every OR so it short-circuits: `get()` is
    // cached per unique path within one rules evaluation, so this costs at most
    // one real document read regardless of how many docs a list query touches.
    //
    // Deliberately a Firestore grant-doc, not a Firebase custom claim: revocation
    // is then instant (no token-refresh propagation delay), and it mirrors the
    // classReps pattern already used for the one other elevated capability in
    // this app. There is no `match /admins/{id}` block granting list access to
    // this collection — only the narrow self-read below, and the `get()` here,
    // which (like every in-rule get/exists call) bypasses the target's own rules.
    //
    // This function only ever appears on READ rules. No write rule anywhere in
    // this file gains an isAdmin() branch — see the note at the bottom of the
    // file for why that split is the actual security boundary.
    //
    // Defined INSIDE this match block, not beside the helpers above it: those
    // never touch the database, but `$(database)` is bound by this block's
    // wildcard and is simply not in scope outside it. Declared above, this
    // compiles with only a warning and then never matches an admin at all —
    // every isAdmin() branch silently evaluates false, which reads exactly like
    // "the grant did not work" rather than like a rules bug.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Student doc id === Firebase Auth uid (see services/firebase/auth.ts).
    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);

      // Self-registration: a student (via the web signup form or the
      // extension) creates their own minimal stub. `profileComplete: false`
      // is forced here so a client can never mint an already-onboarded doc
      // and skip the college-portal capture that supplies the real data.
      allow create: if isOwner(studentId)
        && request.resource.data.uid == studentId
        && request.resource.data.rollNumber is string
        && request.resource.data.profileComplete == false;

      // Self-editable fields: the SRS §27 personal ones, plus everything the
      // college-portal import fills in. `hasOnly` is what keeps rollNumber,
      // uid, email and createdAt immutable after creation — they are absent
      // from this list, so any write touching them is rejected outright.
      allow update: if isOwner(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'department', 'course', 'year', 'section', 'semesterId',
             'collegeId', 'photoUrl', 'admissionNo', 'semesterLabel', 'gender',
             'dob', 'mobileNo', 'profileComplete', 'updatedAt',
             // Push registration tokens, appended by the student's own device
             // (services/notifications/pushService.ts).
             'fcmTokens',
             // Whether the server may send this student a notification when a
             // sync lands. It lives here rather than only on the device
             // because the *server* is what decides whether to send, and it
             // cannot read a phone's preferences.
             'notifyNewData'
           ])
        // semesterId may only ever move to this student's own private
        // namespace — never to an admin-provisioned semester, which would
        // let a self-registered account adopt a real cohort's timetable.
        && (request.resource.data.semesterId == resource.data.semesterId
            || request.resource.data.semesterId == selfNamespace());

      allow delete: if false;
    }

    match /colleges/{collegeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();

      // Self-registered students write their own captured subjects, fenced
      // into their private namespace. Checking `resource` as well as
      // `request.resource` on update is what stops an existing
      // admin-provisioned subject from being hijacked by rewriting its
      // semesterId to the caller's namespace.
      allow create: if isSignedIn()
        && request.resource.data.semesterId == selfNamespace();
      allow update: if isSignedIn()
        && resource.data.semesterId == selfNamespace()
        && request.resource.data.semesterId == selfNamespace();
      allow delete: if false;
    }

    match /timetableVersions/{versionId} {
      // Published versions are visible to any signed-in student; draft
      // versions are only ever read by the Admin SDK, which bypasses rules —
      // or by the admin panel, which needs to see a version before it
      // publishes it.
      allow read: if isAdmin() || (isSignedIn() && resource.data.status == 'published');

      // Self-registered students import their own timetable from the college
      // portal (studenttimetableoption.aspx/ShowTimeTables), fenced into the
      // same private namespace as their subjects — an admin-published version
      // is never writable, because its semesterId can't match.
      allow create: if isSignedIn()
        && request.resource.data.semesterId == selfNamespace();
      allow update: if isSignedIn()
        && resource.data.semesterId == selfNamespace()
        && request.resource.data.semesterId == selfNamespace();
      allow delete: if false;
    }

    match /timetableEntries/{entryId} {
      allow read: if isSignedIn();

      // Entries carry no semesterId of their own, so they're fenced by the
      // version they belong to: buildTimetableDocs() ids every self-imported
      // version `self-<uid>-tt<n>`. matches() is a full-string match, so this
      // is exactly a prefix test, and Firebase uids are alphanumeric — no
      // regex metacharacters can sneak in.
      allow create: if isSignedIn()
        && request.resource.data.timetableVersionId.matches('self-' + request.auth.uid + '-.*');
      allow update: if isSignedIn()
        && resource.data.timetableVersionId.matches('self-' + request.auth.uid + '-.*')
        && request.resource.data.timetableVersionId.matches('self-' + request.auth.uid + '-.*');
      allow delete: if false;
    }

    // Per-day attendance records stay admin-only (SRS §25, §36). The college
    // portal only exposes aggregate attended/held per subject — there is no
    // per-day data to import — so nothing legitimate needs to write here from
    // a client. Attendance History / Calendar stay empty for self-registered
    // students by design.
    match /attendance/{recordId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      // Untouched by isAdmin() — this stays `if false` for every client,
      // admin included. See the note at the bottom of the file.
      allow write: if false;
    }

    // What the student says about their own attendance, day by day.
    //
    // Deliberately a *separate* collection from `attendance` above, which
    // stays admin-only. The college's record and a student's own account of it
    // are different claims and must never be able to overwrite each other: the
    // portal publishes only per-subject totals, so these marks fill the gap
    // between one sync and the next, and the app labels anything derived from
    // them as an estimate rather than as the record.
    //
    // Fully student-owned, including delete — a mark is a note about your own
    // day and mistyping one should not be permanent.
    match /attendanceMarks/{markId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.subjectId is string
        && request.resource.data.date is string
        && request.resource.data.status in ['present', 'absent', 'cancelled'];
    }

    // A student may write their own aggregate summaries, but only ones tagged
    // as coming from the college-portal import — a self-authored row can
    // never masquerade as an admin-seeded one.
    match /attendanceSummaries/{summaryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.source == 'collegePortal';
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.source == 'collegePortal';
      allow delete: if false;
    }

    // Students MAY submit a correction request, but can never approve one.
    match /attendanceCorrections/{correctionId} {
      // Admin gains read here (so a correction request is at least visible),
      // never write — see the note at the bottom of the file. Approving one
      // is exactly the one feature that would legitimately need to touch
      // attendance, so it is deliberately not built.
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Students MAY submit a leave request, but can never approve/reject one —
    // status must stay "pending" through every client-authored write.
    match /leaveRequests/{leaveId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Students may only flip `read` on their own notifications.
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Students MAY report a timetable discrepancy, but never see or touch
    // anyone else's reports, and can never mark one reviewed themselves.
    match /timetableChangeReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    /**
     * Student-authored reminders: assignments, presentations, lab records.
     *
     * The only collection whose contents come from the student rather than
     * from a portal capture, and so the only one a student may fully own —
     * including delete, which is denied everywhere else because those
     * documents are records of what the college reported.
     */
    // Timetables shared by a whole section.
    //
    // A timetable belongs to a section, not a person — fifty students sit in
    // T6(CA3) — so one student's sync tells the rest. Readable by anyone
    // signed in, because a student needs to see the version they were pushed
    // about and the one before it to know what moved.
    //
    // Writes are Admin-SDK only (api/_sharedTimetable.js). A client that could
    // write here could republish a whole section's timetable and push fifty
    // people a notification about it.
    match /sharedTimetables/{timetableId} {
      allow read: if isSignedIn();
      allow write: if false;

      // One document per student, holding the schedule they actually sync.
      //
      // Readable only by its owner. These carry a student's full timetable,
      // and "everyone on T6(CA3)" is not a group anyone consented to share a
      // schedule with — the matching that decides who hears about a change is
      // done server-side with the Admin SDK, where it needs no client read.
      match /members/{memberId} {
        allow read: if isAdmin() || isOwner(memberId);
        allow write: if false;
      }
    }

    // Which room a student sits in, derived from their synced timetable.
    //
    // Server-written only. A student who could add themselves to a group could
    // read another class's announcements; one who could remove themselves from
    // another student's group could silence them. Membership follows the
    // portal, not the client.
    match /classGroupMembers/{membershipId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Who may post to a room. Granted out of band (scripts/grant-class-rep.mjs)
    // and never by the app: a capability that reaches every phone in a class is
    // not one a client should be able to award itself.
    match /classReps/{repId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Announcements, readable by the room they were posted to.
    //
    // The membership lookup is what scopes it: a signed-in student can read an
    // announcement only if a server-written document says they are in that
    // group. Writes go through /api/announce, which re-checks that the caller
    // is that group's rep — a rule alone could not, since being *in* a class
    // is not permission to broadcast to it.
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (isSignedIn()
        && exists(/databases/$(database)/documents/classGroupMembers/$(request.auth.uid + '_' + resource.data.groupKey)));
      allow write: if false;
    }

    // Course material for a class — the shelf, where announcements are the
    // noticeboard. Scoped identically to announcements: readable only if a
    // server-written membership document says you sit in that room.
    //
    // Writes go through /api/notes, which re-checks that the caller is that
    // group's rep. A rule could not: being *in* a class is not permission to
    // put things on its shelf, and deleting is restricted further still, to
    // whoever holds the grant now rather than whoever uploaded it.
    match /classNotes/{noteId} {
      allow read: if isAdmin() || (isSignedIn()
        && exists(/databases/$(database)/documents/classGroupMembers/$(request.auth.uid + '_' + resource.data.groupKey)));
      allow write: if false;
    }

    // Help content, written by whoever runs Handy. Publicly readable — this is
    // the same content the marketing page's own FAQ section shows to a
    // signed-out visitor at /faq, and none of it is student data. No client
    // write at all: an FAQ a student can edit is a notice board.
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    // Feedback is write-only from the app's point of view, for everyone
    // except the admin panel.
    //
    // A student may post their own, and may not read anyone's — including
    // their own back. That is deliberate: `list` on this collection would
    // otherwise be one rule change away from exposing every student's
    // complaints, and nothing in the *student* app needs to read them. The
    // admin panel is the intended reader — this was previously read with the
    // Admin SDK outside these rules entirely; isAdmin() now gives it a real
    // (still narrow) client-side read path instead.
    //
    // No update or delete either. Feedback that can be edited after the fact
    // is not a record of anything.
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000;
      allow update, delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.dueDate is string
        // Absent (older client) or one of the five known cadences — never an
        // arbitrary string a rolled-forward repeat check could later choke on.
        && (!('repeat' in request.resource.data)
          || request.resource.data.repeat in ['none', 'daily', 'weekly', 'fortnightly', 'monthly']);
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // The admin panel's own identity. No block granting list/read of the
    // whole collection to any client — see isAdmin()'s comment above for why
    // that's deliberate. An admin may read only their own doc, to show
    // "signed in as ___"; the panel's `/admins` page (listing/granting/
    // revoking others) goes through admin/api/*.js with the Admin SDK, which
    // needs no rule here at all.
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Study materials the admin panel publishes. Any signed-in student may
    // read them — that's the point — but only the admin backend writes them.
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Release/changelog records the admin panel publishes (app version,
    // extension version, download links). Same shape as materials.
    match /appUpdates/{updateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // First-class semester and faculty records the admin panel manages —
    // replacing what used to be a free-text semesterId/facultyName typed into
    // a form each time. Same read/write shape as materials/appUpdates: any
    // signed-in user may read them (a subject picker needs to resolve a
    // faculty name; nothing here is sensitive), only the admin backend writes.
    match /semesters/{semesterId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /faculty/{facultyId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --------------------------------------------------------------------
    // Why isAdmin() only ever appears on a `read` line, never a `write`,
    // `create`, `update`, or `delete` line, anywhere in this file:
    //
    // Every privileged action the admin panel performs — editing a student's
    // profile, resetting a password, granting a class rep, authoring a
    // subject or timetable, posting an announcement, publishing a material,
    // sending a notification — goes through admin/api/*.js, which verifies
    // the caller's ID token and admins/{uid} status itself, then writes with
    // the Admin SDK (which bypasses these rules entirely, exactly like
    // scripts/seed-students.mjs already does for other privileged writes).
    //
    // `attendance` and `attendanceSummaries` therefore keep `allow write: if
    // false` with no isAdmin() exception, full stop — not because no
    // admin/api/*.js endpoint happens to write there today, but because none
    // ever will. That is the actual guarantee behind "the admin cannot change
    // a student's attendance": it is not a missing button, it is a write path
    // that does not exist to be called, client or server.
  }
}
